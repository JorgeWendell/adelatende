# Copie este arquivo para .env no servidor antes de subir os containers:
#   cp .env.docker.example .env
#
# Troque senhas e chaves. O banco Docker começa vazio
# (volume novo). Para zerar de novo: docker compose down -v

# PostgreSQL (container Docker — adelatende-db)
# Evite @ : / ? # na senha — ela entra na DATABASE_URL.
POSTGRES_USER=adelatende
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DB=adelatende

# Painel — https://atende.adelweb.com.br
APP_DOMAIN=atende.adelweb.com.br
BETTER_AUTH_SECRET=troque_por_um_secret_longo_e_aleatorio
BETTER_AUTH_URL=https://atende.adelweb.com.br
NEXT_PUBLIC_BASE_URL=https://atende.adelweb.com.br

# Evolution — https://wpp.adelweb.com.br
WPP_DOMAIN=wpp.adelweb.com.br
EVOLUTION_SERVER_URL=https://wpp.adelweb.com.br
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=troque_por_uma_chave_longa
EVOLUTION_WEBHOOK_URL=http://app:3000/api/webhooks/evolution
EVOLUTION_WEBHOOK_SECRET=

# Traefik (igual ao ERP / eventos / Adelmsp)
TRAEFIK_NETWORK=proxy
